# Example environment variables file
# Copy this to .env and fill in your actual values

# MySQL Configuration
MYSQL_DATABASE=tachos
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_HOST=your_mysql_host
MYSQL_PORT=3306

# MongoDB Configuration
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE=tachos

# Neo4j Configuration
NEO4J_URI=bolt://your_neo4j_host:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j

# Redis Configuration
REDIS_URL=redis://redis:6379
REDIS_TTL_SECONDS=300

# Route Service Configuration (servicio externo que calcula rutas)
ROUTE_SERVICE_URL=https://your-route-service.com/calculate-routes

# Cron Job Configuration (generar con: openssl rand -hex 32)
CRON_API_KEY=your_secure_random_key_here

# JWT Configuration
JWT_ACCESS_SECRET=your_jwt_access_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_H=168

# Prometheus/Grafana Cloud Configuration
GRAFANA_USERNAME=your_grafana_user_id
GRAFANA_PASSWORD=your_grafana_api_key

# App Configuration
APP_PORT=8080
APP_ENV=dev
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
PORT=8080
SWAGGER_HOST=localhost:8080
SWAGGER_SCHEME=http